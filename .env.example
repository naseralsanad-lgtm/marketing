# Marketing Planner — environment configuration
# Copy to .env.local and restart the server. Every key is optional: without them the app runs
# local-first with clearly-labelled demonstration data and built-in (non-AI) planning logic.

# --- Modash Discovery API (server-side only; never exposed to the browser) ---------------
# https://docs.modash.io  →  Discovery API access token
MODASH_API_KEY=
# MODASH_BASE_URL=https://api.modash.io/v1
# MODASH_RPS=2                # outbound requests per second (match your plan's limit)

# --- Anthropic Claude API (server-side only) ----------------------------------------------
# https://platform.claude.com  →  API keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase (optional: sign-in + cloud sync) --------------------------------------------
# Project settings → API. The anon key is public by design; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
